{
    "name": "mca/access-intel",
    "description": "IP health scoring and traffic intel on top of mca/access-log (MCA Access suite).",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "mca", "access", "intel", "scoring", "security", "analytics"],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "suggest": {
        "mca/access-log": "Required for scoring — reads access logs",
        "mca/firewall": "Block / whitelist suspicious IPs from intel UI",
        "mca/permission": "Root access middleware for intel admin UI",
        "mca/hub": "MCA package hub integration"
    },
    "autoload": {
        "psr-4": {
            "Mca\\AccessIntel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mca\\AccessIntel\\AccessIntelServiceProvider"
            ]
        },
        "mca": {
            "slug": "access-intel",
            "title": {
                "en": "Access Intel",
                "tr": "Erişim Analizi"
            },
            "description": {
                "en": "IP health scores from access logs — healthy vs risky traffic.",
                "tr": "Erişim günlüğünden IP sağlık skorları — sağlıklı / riskli trafik."
            },
            "route": "mca.access-intel.index",
            "github": "https://github.com/MCA43/mca-access-intel",
            "icon": "activity",
            "order": 32,
            "frameworks": ["laravel13"],
            "suite": "access",
            "suite_role": "intel",
            "suggests": ["mca/access-log", "mca/firewall", "mca/permission", "mca/hub"],
            "provides": ["ip-health-score"]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
